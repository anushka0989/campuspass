{
  "name": "campuspass",
  "version": "1.1.0",
  "description": "Campus Event and Talk Ticketing System",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "test": "node tests/run-all.js",
    "test:smoke": "node tests/smoke.js",
    "test:scale": "node tests/scale.js rowlock",
    "test:scale:atomic": "node tests/scale.js atomic",
    "test:naive": "node tests/scale.js naive",
    "test:bench": "node tests/bench.js",
    "test:cancel": "node tests/cancel-vs-book.js",
    "test:waitlist": "node tests/waitlist.js",
    "test:limit": "node tests/limit.js",
    "test:checkin": "node tests/checkin.js",
    "test:controls": "node tests/organizer-controls.js",
    "test:authz": "node tests/authz.js",
    "test:invariants": "node tests/invariants.js",
    "test:clean": "node tests/clean.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  }
}