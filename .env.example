# Copy this file to .env and adjust. Never commit .env.

# Port 5433 matches docker-compose.yml (5433 avoids clashing with a PostgreSQL installed on Windows).
# If your password has special characters, URL-encode them: @ becomes %40, # becomes %23.
DATABASE_URL=postgres://postgres:dev@localhost:5433/campuspass

PORT=3000
NODE_ENV=development

# Long random strings, different from each other. Required when NODE_ENV=production.
SESSION_SECRET=replace-with-a-long-random-string
HMAC_SECRET=replace-with-another-long-random-string

# Organizers can only sign up with this code. Leave empty to disable organizer sign-up.
ORGANIZER_CODE=choose-a-code-to-share-with-organizers

# Optional
# MAX_ACTIVE_BOOKINGS=3
# BCRYPT_ROUNDS=10
